generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // Hashed
  role      String   @default("USER") // "ADMIN" or "USER"
  createdAt DateTime @default(now())
  days      Day[]
  habits    Habit[]
}

model Day {
  id          String      @id @default(cuid())
  date        String      // YYYY-MM-DD format
  startTime   String      // HH:MM format
  endTime     String      // HH:MM format
  completed   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  timeBlocks  TimeBlock[]
  
  // Sleep tracking fields (all optional)
  sleepTime     String?   // When went to bed yesterday (HH:MM)
  wakeTime      String?   // When woke up today (HH:MM)
  sleepDuration Float?    // Hours of sleep
  sleepQuality  String?   // GOOD, DEEP, LIGHT, RESTLESS, POOR
  
  // Weight tracking
  weight        Float?    // Body weight in kg
  
  // Calorie tracking
  calories      Int?      // Daily calorie intake
  
  userId      String?     // Optional for migration compatibility, will be required later
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([date, userId])
}

model TimeBlock {
  id        String   @id @default(cuid())
  startTime String   // HH:MM format
  endTime   String   // HH:MM format
  done      Boolean  @default(false)
  skipped   Boolean  @default(false) // User marked as not worked
  activity  String   @default("")
  dayId     String
  day       Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rating    BlockRating?

  @@index([dayId])
}

model Habit {
  id            String     @id @default(cuid())
  name          String
  description   String?
  color         String     @default("#3b82f6") // hex color
  icon          String     @default("📝")      // emoji
  goalFrequency Int        @default(7)         // Days per week goal
  type          HabitType  @default(ABSTINENCE)
  createdAt     DateTime   @default(now())
  
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  logs          HabitLog[]

  @@index([userId])
}

model HabitLog {
  id        String   @id @default(cuid())
  date      String   // YYYY-MM-DD
  value     Int      @default(1) // Can be used for quantity (pages, minutes) or just 1 for boolean
  createdAt DateTime @default(now())
  
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date]) // One log per habit per day
  @@index([habitId])
}

enum BlockRating {
  PRODUCTIVE
  MODERATE
  DISTRACTED
}

enum HabitType {
  POSITIVE
  ABSTINENCE
}
